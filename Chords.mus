compose Chords

// Chord progressions using the chord(root, quality, beats) builtin and the
// named constants Pitch.<note>, Chord.<quality> and Duration.<length>.
// Chord qualities: Major, Minor, Dim, Aug, Dom7, Maj7, Min7 (codes 0 to 6)

// I - V - vi - IV in the key whose tonic is 'key'
func void popProgression(Pitch key, Duration beats) {
    chord(key,     Chord.Major, beats);   // I
    chord(key + 7, Chord.Major, beats);   // V
    chord(key + 9, Chord.Minor, beats);   // vi
    chord(key + 5, Chord.Major, beats);   // IV
}

// ii7 - V7 - Imaj7 jazz turnaround
func void twoFiveOne(Pitch key) {
    chord(key + 2, Chord.Min7, Duration.Half);    // ii7
    chord(key + 7, Chord.Dom7, Duration.Half);    // V7
    chord(key,     Chord.Maj7, Duration.Whole);   // Imaj7
}

main {
    tempo(100);
    instrument(0);              // acoustic grand piano

    // Play the pop progression in C, then in G
    popProgression(Pitch.C4, Duration.Half);
    popProgression(Pitch.G3, Duration.Half);
    rest(Duration.Quarter);

    // Every chord quality on C, one after another (a quality is a code 0 to 6)
    Chord q = Chord.Major;
    while (q <= Chord.Min7) {
        chord(Pitch.C4, q, Duration.Quarter);
        q = q + 1;
    }
    rest(Duration.Quarter);

    // ii-V-I turnaround, then a final melody note
    twoFiveOne(Pitch.C4);
    play(Pitch.C5, Duration.Half);
}
