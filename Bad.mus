compose Bad
func int twice(int x) { return x * 2; }
song S { tempo(100); track t { play(60,1); } }
main {
    play(Pitch.H9, 1);
    int x = 99999999999;
    int a = true;
    bool b = 5;
    if (x) { print(1); }
    while (1 + 2) { print(2); }
    bool c = !5;
    int d = true + 1;
    bool e = (1 < 2) && 3;
    bool f = (1 == true);
    print(twice(true));
    bool g = twice(2);
    a = false;
}
